{
  "$schema": "https://unpkg.com/knip@5/overview/configuration-schema.json",
  "entry": [
    "scripts/*.ts",
    "apps/bot/load-tests/*.ts",
    "apps/bot/test/**/*.ts",
    "apps/web/test/**/*.ts",
    "test/**/*.ts",
    "apps/web/src/hub/main.ts",
    "apps/web/src/spread/main.ts",
    "apps/web/src/analytics/main.ts",
    "apps/web/src/checker/main.ts"
  ],
  "project": [
    "src/**/*.ts",
    "apps/bot/src/**/*.ts",
    "apps/bot/test/**/*.ts",
    "apps/bot/load-tests/**/*.ts",
    "apps/web/src/**/*.ts",
    "apps/web/test/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts"
  ],
  "ignoreDependencies": ["postcss", "tailwindcss"]
}
