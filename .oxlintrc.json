{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-await-in-loop": "off",
    "typescript/no-explicit-any": "off"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["node_modules", ".wrangler", "dist"]
}
