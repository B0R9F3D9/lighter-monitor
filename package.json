{
  "name": "lighter-monitor",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "web": "bun run build && bun -e 'import app from \"./src/index.ts\"; Bun.serve({ port: 3000, fetch: (req) => app.fetch(req, {} as any, {} as any) }); console.log(\"\\n⚡ Web Scanner live at http://localhost:3000/spread\\n\");'",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "build:web": "bun run --cwd apps/web build",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:init": "wrangler d1 execute lighter-db --local --file=./apps/bot/schema.sql",
    "d1:migrate": "wrangler d1 execute lighter-db --remote --file=./apps/bot/schema.sql",
    "seed": "bun apps/bot/load-tests/seed.ts > apps/bot/load-tests/seed.sql && wrangler d1 execute lighter-db --local --file=./apps/bot/load-tests/seed.sql",
    "profile": "bun apps/bot/load-tests/profile_engine.ts",
    "simulate": "bun apps/bot/load-tests/simulate_cron_tick.ts",
    "prepare": "bun run build",
    "test": "bun run build && bun test",
    "test:bot": "bun test apps/bot",
    "test:web": "bun test apps/web",
    "typecheck": "tsc --noEmit && bun run --cwd apps/bot typecheck && bun run --cwd apps/web typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@types/bun": "latest",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.150.0"
  }
}
