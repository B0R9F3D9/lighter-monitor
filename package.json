{
  "name": "lighter-monitor",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "web": "bun -e 'import app from \"./src/index.ts\"; Bun.serve({ port: 3000, fetch: (req) => app.fetch(req, {} as any, {} as any) }); console.log(\"\\n⚡ Web Scanner live at http://localhost:3000/spread\\n\");'",
    "dev:web": "vite",
    "build:web": "bun scripts/build_web.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:init": "wrangler d1 execute lighter-db --local --file=./schema.sql",
    "seed": "bun load-tests/seed.ts > load-tests/seed.sql && wrangler d1 execute lighter-db --local --file=./load-tests/seed.sql",
    "profile": "bun load-tests/profile_engine.ts",
    "simulate": "bun load-tests/simulate_cron_tick.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "grammy": "^1.35.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "autoprefixer": "^10.6.1",
    "html-minifier-terser": "^7.2.0",
    "lightweight-charts": "^5.2.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "wrangler": "^3.109.0"
  }
}
